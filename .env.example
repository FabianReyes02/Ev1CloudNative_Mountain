# URL base de la API de AWS API Gateway
VITE_API_BASE_URL=https://TU_API_ID.execute-api.TU_REGION.amazonaws.com

# false = usa los microservicios desplegados
VITE_USE_MOCK=false

# Microsoft Entra ID / Azure AD
VITE_AZURE_CLIENT_ID=TU_CLIENT_ID_DEL_FRONTEND
VITE_AZURE_TENANT_ID=TU_TENANT_ID
# Scope expuesto por el registro de aplicación de la API
VITE_AZURE_API_SCOPE=api://TU_CLIENT_ID_DE_LA_API/orders.write