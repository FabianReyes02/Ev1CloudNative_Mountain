# Copiar a .env y completar. Nunca publicar .env (está en .gitignore).
#
# Producción EC2 (nginx proxea /api al backend por IP privada, mismo origen):
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
#
# Local (backend levantado con docker compose en :9000):
# VITE_API_BASE_URL=http://localhost:9000

# Azure Entra ID (App Registration de la SPA y de la API):
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_API_SCOPE=api://TU_CLIENT_ID_API/orders.write

# Verificación client-side del JWT (estructura, vigencia, emisor, audiencia y permisos).
# Aceptan listas separadas por coma para soportar local (HS256) + Azure (RS256) a la vez.
# Local: pedidos360-usuarios / pedidos360-api / orders.write
# Azure: https://login.microsoftonline.com/{TENANT}/v2.0 / api://{CLIENT-ID} / orders.write
VITE_JWT_ISSUERS=pedidos360-usuarios
VITE_JWT_AUDIENCES=pedidos360-api
VITE_JWT_REQUIRED_SCOPES=orders.write
VITE_JWT_REQUIRED_ROLES=
