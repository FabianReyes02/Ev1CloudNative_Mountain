# Copiar a .env y completar. Nunca publicar .env (está en .gitignore).
#
# Local (backend levantado con docker compose en :9000):
VITE_API_BASE_URL=http://localhost:9000
VITE_USE_MOCK=false

# Azure Entra ID (App Registration de la SPA y de la API):
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_API_SCOPE=api://TU_CLIENT_ID_API/orders.write